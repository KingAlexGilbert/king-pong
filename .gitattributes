# Automatically detect text files and use LF on all platforms
* text=auto eol=lf

# Windows batch scripts
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files must not be converted
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.zip binary
*.apk binary
*.exe binary
*.pdf binary
